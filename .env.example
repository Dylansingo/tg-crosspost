# tg-crosspost environment.
# Every key below is optional. Leave the file unused for `npm run demo`,
# which runs offline and forces DRY_RUN. A platform switches on only when
# every key in its group is present. A partly filled group stays off and
# the process names the missing keys. Values shown are defaults, not secrets.

# Bot token from BotFather. Used to call getFile and download media.
# Platform: Telegram ingestion. Optional.
# TELEGRAM_BOT_TOKEN=

# Shared secret passed as secret_token to setWebhook. Telegram echoes it in
# the X-Telegram-Bot-Api-Secret-Token header. Use 1–256 characters from
# A–Z, a–z, 0–9, underscore, and hyphen.
# Platform: Telegram ingestion. Optional.
# TELEGRAM_WEBHOOK_SECRET=

# Numeric id of the channel whose channel_post updates are ingested.
# The bot has to be an administrator of that channel.
# Platform: Telegram ingestion. Optional.
# CHANNEL_ID=

# Chat that receives a message when a platform publish fails. The bot must
# be able to message this chat. Also required for Telegram ingestion.
# Platform: Telegram ingestion. Optional.
# ADMIN_CHAT_ID=

# When true (the default), publishing writes ./out/payloads and ./out/preview.html
# and does not call Instagram, Snapchat, TikTok, or Telegram.
# Set to false to publish. Live publishing refuses file:// media URLs.
# Demo mode always forces true.
# Platform: application. Optional.
# DRY_RUN=true

# SQLite file for the idempotency table. Defaults to ./data/tg-crosspost.db.
# Platform: application. Optional.
# SQLITE_PATH=./data/tg-crosspost.db

# Cloudflare account id that owns the R2 bucket.
# Platform: R2. Optional.
# R2_ACCOUNT_ID=

# R2 access key id (S3-compatible).
# Platform: R2. Optional.
# R2_ACCESS_KEY_ID=

# R2 secret access key.
# Platform: R2. Optional.
# R2_SECRET_ACCESS_KEY=

# R2 bucket that will hold staged media.
# Platform: R2. Optional.
# R2_BUCKET=

# Public base URL for objects in the bucket, for example https://media.example.com.
# Platform: R2. Optional.
# R2_PUBLIC_BASE_URL=

# Instagram professional account id used by the Graph API.
# Platform: Instagram. Optional.
# IG_USER_ID=

# Instagram Graph API user access token.
# Platform: Instagram. Optional.
# IG_ACCESS_TOKEN=

# API key for Zernio. Shared by Snapchat and by TikTok when TIKTOK_VIA=zernio.
# Platform: Snapchat/Zernio and TikTok/Zernio. Optional.
# ZERNIO_API_KEY=

# Zernio API origin. Defaults to https://zernio.com/api when unset.
# The client calls {origin}/v1/posts (https://zernio.com/api/v1/posts).
# Platform: Snapchat/Zernio and TikTok/Zernio. Optional.
# ZERNIO_BASE_URL=https://zernio.com/api

# Zernio profile id that receives Snapchat stories.
# Platform: Snapchat/Zernio. Optional.
# ZERNIO_SNAPCHAT_ACCOUNT_ID=

# Zernio profile id that receives TikTok photo posts.
# Platform: TikTok/Zernio. Optional. Used when TIKTOK_VIA=zernio (the default).
# ZERNIO_TIKTOK_ACCOUNT_ID=

# TikTok route: zernio (default) or native.
# Platform: TikTok. Optional.
# TIKTOK_VIA=zernio

# Native TikTok client key. Used only when TIKTOK_VIA=native.
# Platform: TikTok (native). Optional.
# TIKTOK_CLIENT_KEY=

# Native TikTok client secret. Used only when TIKTOK_VIA=native.
# Platform: TikTok (native). Optional.
# TIKTOK_CLIENT_SECRET=

# Native TikTok access token for the Content Posting API.
# Platform: TikTok (native). Optional.
# TIKTOK_ACCESS_TOKEN=

# Privacy level for TikTok photo posts (Zernio and native).
# One of SELF_ONLY (default), MUTUAL_FOLLOW_FRIENDS, FOLLOWER_OF_CREATOR,
# PUBLIC_TO_EVERYONE. The default does not by itself enable the platform.
# Public posting needs TikTok's app audit. Native PULL_FROM_URL also needs
# a domain verified for the app. Leave SELF_ONLY until both are done.
# Platform: TikTok. Optional.
# TIKTOK_PRIVACY=SELF_ONLY
